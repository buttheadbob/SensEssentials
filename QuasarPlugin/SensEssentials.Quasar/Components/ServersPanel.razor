@implements IDisposable
@inject SharedConfigStore Store
@inject SharedConfigSync Sync

<section class="quasar-panel se-section">
    <div class="quasar-form-section">
        <h2>Servers</h2>
        <p class="se-hint">
            @if (Highlight != null)
            {
                @:Choose which servers follow "@Highlight.Name". A server gets the last saved revision; save to send your changes.
            }
            else
            {
                @:Choose the shared config each server follows. Servers configured on their own are edited on their Plugins page as usual.
            }
        </p>
        @if (_error != null)
        {
            <div class="quasar-notice quasar-notice-error">@_error</div>
        }
        @{
            var servers = Sync.GetServers().Where(s => !s.IsCluster).ToList();
            var configs = Store.GetConfigs();
            var assignments = Store.GetAssignments();
        }
        @if (servers.Count == 0)
        {
            <p class="se-hint">No servers are connected to Quasar right now. Servers show up here once they are running.</p>
        }
        else
        {
            <div class="quasar-table-scroll">
                <table class="se-server-table">
                    <thead>
                        <tr>
                            <th>Server</th>
                            <th>Shared config</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var server in servers)
                        {
                            var assignment = assignments.GetValueOrDefault(server.ServerId);
                            var config = assignment == null ? null : configs.FirstOrDefault(c => c.Id == assignment.ConfigId);
                            var (text, tone) = Describe(server, config);
                            <tr class="@(Highlight != null && config?.Id == Highlight.Id ? "se-selected" : "")" @key="server.ServerId">
                                <td>
                                    <span class="se-server-name">@server.DisplayName</span>
                                    @if (server.Status is { Installed: true, Version.Length: > 0 } status)
                                    {
                                        <span class="se-hint"> Sens Essentials @status.Version</span>
                                    }
                                </td>
                                <td>
                                    <select @key="@($"{server.ServerId}:{_selectVersion}")" value="@(config?.Id ?? "")" aria-label="@($"Shared config for {server.DisplayName}")"
                                            @onchange="e => Ask(server, e.Value?.ToString())">
                                        <option value="">Configured on its own</option>
                                        @foreach (var option in configs)
                                        {
                                            <option value="@option.Id">@option.Name</option>
                                        }
                                    </select>
                                </td>
                                <td class="@tone">@text</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

@if (_pendingServer != null)
{
    var name = _pendingServer.DisplayName;
    <div class="se-modal-backdrop">
        <div class="se-modal" role="dialog" aria-modal="true" aria-labelledby="se-confirm-title">
            @if (_pendingConfig != null)
            {
                <h3 id="se-confirm-title">Replace the settings of @name?</h3>
                <p>@name takes every Sens Essentials setting from "@_pendingConfig.Name" (revision @_pendingConfig.Revision) right away.
                    Its own auto commands, presets and Discord handlers are replaced, and this cannot be undone.</p>
                <p>Unsaved edits on this page are not included.</p>
            }
            else
            {
                <h3 id="se-confirm-title">Stop following the shared config?</h3>
                <p>@name keeps the settings it has now, and can be edited by itself on its Plugins page.</p>
            }
            <div class="se-modal-actions">
                <button type="button" class="quasar-button" @onclick="Cancel">Cancel</button>
                <button type="button" class="quasar-button quasar-button-primary" @onclick="Accept">@(_pendingConfig != null ? "Replace settings" : "Stop following")</button>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>The config being edited, whose servers are highlighted. Null for the overview.</summary>
    [Parameter] public SharedConfig? Highlight { get; set; }

    /// <summary>Called after a server is assigned, so its result can be followed.</summary>
    [Parameter] public Action<ServerState, SharedConfig?>? Assigned { get; set; }

    private string? _error;
    private ServerState? _pendingServer;
    private SharedConfig? _pendingConfig;
    private int _selectVersion;

    protected override void OnInitialized()
    {
        Sync.Changed += OnChanged;
        Store.Changed += OnChanged;
    }

    public void Dispose()
    {
        Sync.Changed -= OnChanged;
        Store.Changed -= OnChanged;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private void Ask(ServerState server, string? configId)
    {
        _pendingServer = server;
        _pendingConfig = string.IsNullOrEmpty(configId) ? null : Store.GetConfigs().FirstOrDefault(c => c.Id == configId);
    }

    private void Accept()
    {
        var server = _pendingServer!;
        var config = _pendingConfig;
        _pendingServer = null;
        _pendingConfig = null;
        try
        {
            _error = null;
            Store.Assign(server.ServerId, server.DisplayName, config?.Id);
            Assigned?.Invoke(server, config);
        }
        catch (Exception e)
        {
            _error = e.Message;
            _selectVersion++;
        }
    }

    // The list already shows the choice, so it is rebuilt to show the real one again.
    private void Cancel()
    {
        _pendingServer = null;
        _pendingConfig = null;
        _selectVersion++;
    }

    private static (string Text, string Tone) Describe(ServerState server, SharedConfig? config)
    {
        if (!server.Online)
            return (config == null ? "Offline" : "Offline. Gets the config when it connects.", "se-muted");
        if (server.Error != null)
            return ($"The server did not take the change: {server.Error} Restart the server if it was started before this plugin was enabled.", "quasar-text-error");
        if (server.Status == null)
            return ("Checking...", "se-muted");
        if (!server.Status.Installed)
            return ("Sens Essentials is not loaded on this server.", "quasar-text-warning");
        if (config != null)
            return server.Status.ConfigId == config.Id && server.Status.Revision == config.Revision
                ? ($"Up to date (revision {config.Revision}).", "quasar-text-success")
                : ("Sending the config...", "se-muted");
        return string.IsNullOrEmpty(server.Status.ConfigId)
            ? ("Configured on its own.", "se-muted")
            : ($"Releasing from \"{server.Status.Name}\"...", "se-muted");
    }
}
