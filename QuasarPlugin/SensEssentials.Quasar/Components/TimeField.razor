<label class="quasar-field se-narrow">
    @Label
    <input class="@(SharedConfigValues.IsTime(Value) ? "" : "se-invalid")" value="@Value" @onchange="OnChange" placeholder="00:00:00" />
    @if (!SharedConfigValues.IsTime(Value))
    {
        <span class="quasar-field-error">Use HH:MM:SS, for example 01:30:00.</span>
    }
    else if (Hint != null)
    {
        <small>@Hint</small>
    }
</label>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Hint { get; set; }

    private Task OnChange(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString()?.Trim() ?? "");
}
